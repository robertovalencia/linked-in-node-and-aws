+    # Recognize only the companion's standalone, empty stable-card anchors.
+    # Raw HTML stays disabled, including inside code fences and inline examples.
+    def stable_card_anchor(state, start_line, end_line, silent):
+        if state.is_code_block(start_line):
+            return False
+        start = state.bMarks[start_line] + state.tShift[start_line]
+        line = state.src[start:state.eMarks[start_line]]
+        match = re.fullmatch(r'<a id="((?:source-)?n[rso]i?[0-9]{2})"></a>\s*', line)
+        if not match:
+            return False
+        if not silent:
+            token = state.push("stable_card_anchor", "a", 0)
+            token.attrSet("id", match.group(1))
+            token.block = True
+            token.map = [start_line, start_line + 1]
+            state.line = start_line + 1
+        return True
+    md.block.ruler.before("paragraph", "stable_card_anchor", stable_card_anchor)
+    md.renderer.rules["stable_card_anchor"] = lambda tokens, idx, options, env: (
